<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageVersion>0.1.2.5</PackageVersion>
        <PackageId>Bunyamin.Sakar.CleanArchitecture</PackageId>
        <Title>Clean Architecture</Title>
        <Authors>Bunyamin Sakar</Authors>
        <Description>Templates to use when creating an Cloud application</Description>
        <PackageTags>dotnet-new;templates;</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>

        <Copyright>Bunyamin Sakar</Copyright>
        <PackageCopyright>Copyright © Bunyamin Sakar. All rights Reserved</PackageCopyright>
        <PackageProjectUrl>https://github.com/bunyu93/CleanArchitecture</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/bunyu93/CleanArchitecture</RepositoryUrl>

        <TargetFramework>net10.0</TargetFramework>

        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <NoDefaultExcludes>true</NoDefaultExcludes>
    </PropertyGroup>
    
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="src\**\*"
                 Exclude="src\**\bin\**;
                          src\**\obj\**;
                          src\**\.vs\**;
                          src\**\.idea\**;
                          src\**\.claude\**;
                          src\**\*.user;
                          src\**\.env;
                          src\*.sln;
                          src\*.slnx;
                          src\**\.DS_Store;
                          src\**\._*;
                          src\**\.AppleDouble\**;
                          src\**\__MACOSX\**;
                          src\**\.Spotlight-V100\**;
                          src\**\.Trashes;
                          src\**\.fseventsd\**;
                          src\**\.TemporaryItems;
                          src\**\.VolumeIcon.icns;
                          src\**\.LSOverride;
                          src\**\.DocumentRevisions-V100\**;
                          src\**\.com.apple.timemachine.donotpresent;
                          src\**\.AppleDB\**;
                          src\**\.AppleDesktop\**;
                          src\**\.apdisk;
                          src\**\Network Trash Folder\**;
                          src\**\Temporary Items\**;
                          src\**\Thumbs.db" />
        <Compile Remove="**\*" />
    </ItemGroup>
</Project>